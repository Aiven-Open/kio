// Aiven fork addition (KAFKA-20295): retire a controller from feature and
// metadata.version upgrade decisions without physically removing its
// registration. The API key, version, and field layout deliberately match
// upstream UnregisterController v0 (KIP-1312), while this pre-KIP operation
// records a decommission marker instead of deleting the registration.
{
  "apiKey": 94,
  "type": "request",
  "listeners": ["broker", "controller"],
  "name": "DecommissionControllerRequest",
  "validVersions": "0",
  "flexibleVersions": "0+",
  "javaTest": false,
  "fields": [
    { "name": "ControllerId", "type": "int32", "versions": "0+",
      "about": "The controller ID to decommission." }
  ]
}
